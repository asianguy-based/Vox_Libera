# Cloudflare Pages header rules.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Goal: hashed build assets (which get a brand-new filename on every build,
# e.g. index-abc123.js) can be cached forever, but service-worker.js and
# manifest.json must always be re-checked so PWA updates roll out promptly
# instead of getting stuck behind a stale edge/browser cache.

# The service worker script itself: never let the CDN or browser cache it.
# The browser already re-checks this file on every navigation per spec, but
# an aggressively-cached edge copy would defeat that and delay updates for
# all users behind this PoP.
/service-worker.js
  Cache-Control: no-cache

# The manifest can change (icons, name, theme) without a new deploy hash,
# so keep it short-lived rather than immutable.
/manifest.json
  Cache-Control: public, max-age=3600

# Update-check probe file (utils/updateCheck.ts fetches this on launch to
# see if a newer version has been deployed). Must never be cached - stale
# copies would either hide real updates or show phantom "update available"
# popups for a version that's already installed.
/version.json
  Cache-Control: no-cache, no-store, must-revalidate

# Hashed, content-fingerprinted JS/CSS bundle - safe to cache forever since
# any change produces a brand-new filename automatically (Vite content
# hashing). Scoped to "index-*" (the actual bundle filenames) rather than a
# blanket "/assets/*" - see the BUG note below for why that matters.
/assets/index-*
  Cache-Control: public, max-age=31536000, immutable

# BUG FIXED (2026-08-26, see CACHE_VERSION v6 note in service-worker.js):
# public/assets/ also holds plain, NON-hashed static images (app logo,
# social-cover, watermark, favicon/PWA icons) that keep the exact same
# filename even when their pixel content changes - e.g. the v1.2.0
# brand-kit rebrand replaced logo.png and the icons in place. A previous
# blanket "/assets/*" rule marked ALL of /assets/ (including these) as
# "immutable" for a year, so both the Cloudflare edge cache and every
# visitor's browser kept serving the OLD logo/icons long after the new
# ones were deployed - a hard refresh didn't even help because the browser
# never re-requested them at all. Give these a short, revalidate-friendly
# cache instead so a rebrand actually reaches users promptly.
/assets/logo.png
  Cache-Control: public, max-age=3600, must-revalidate
/assets/social-cover.png
  Cache-Control: public, max-age=3600, must-revalidate
/assets/watermark.png
  Cache-Control: public, max-age=3600, must-revalidate
/assets/icons/*
  Cache-Control: public, max-age=3600, must-revalidate
